# ========== 异常检测 ==========

def detect_anomaly(events: list, current_gear: int, current_sc: float):
    """
    读取最近事件列表，检测异常模式。
    返回 None 表示无异常，返回 dict 表示检测到异常。
    """
    recent = events[-20:]

    # 规则 1：Sc 连续 3 次 TOOL_CALL 累积 +0.09（失控前兆）
    tool_calls = [e for e in recent if e.get("event_type") == "TOOL_CALL"]
    if len(tool_calls) >= 3:
        last_3 = tool_calls[-3:]
        total_delta = sum(e.get("delta_entropy", 0) or e.get("entropy_delta", 0) for e in last_3)
        if total_delta >= 0.09:
            return {
                "rule": "sc_rapid_rise",
                "message": f"Sc 在最近 3 次工具调用中累积上升 {total_delta:.2f}，失控前兆",
                "severity": "warning",
            }

    # 规则 2：5 分钟内档位连续升级 2+ 次（升级链过快）
    now = datetime.utcnow()
    recent_switches = []
    for e in recent:
        if e.get("event_type") == "GEAR_SWITCH":
            try:
                ts = e["timestamp"].replace("Z", "")
                if "+" in ts:
                    ts = ts.split("+")[0]
                evt_time = datetime.fromisoformat(ts)
                if (now - evt_time) < timedelta(minutes=5):
                    recent_switches.append(e)
            except Exception:
                pass
    if len(recent_switches) >= 2:
        return {
            "rule": "rapid_upgrade",
            "message": f"5 分钟内发生 {len(recent_switches)} 次档位切换，升级链过快",
            "severity": "critical",
        }

    # 规则 3：同一工具被调用 3+ 次且全部失败（反复重试）
    failed = [e for e in recent if e.get("event_type") == "TOOL_CALL" and not e.get("success", True)]
    tool_names = {}
    for e in failed:
        tn = e.get("action", "unknown")
        tool_names[tn] = tool_names.get(tn, 0) + 1
    for tn, count in tool_names.items():
        if count >= 3:
            return {
                "rule": "repeated_failure",
                "message": f"工具 {tn} 连续失败 {count} 次，反复重试",
                "severity": "warning",
            }

    # 规则 4：Sc 接近档位上界 90%
    gear_max = {1: 0.5, 2: 1.0, 3: 1.0, 4: float("inf")}
    upper = gear_max.get(current_gear, 1.0)
    if upper < float("inf") and current_sc > upper * 0.9:
        return {
            "rule": "sc_near_boundary",
            "message": f"Sc={current_sc:.2f} 接近当前档位上界 {upper:.2f} 的 90%",
            "severity": "warning",
        }

    return None


