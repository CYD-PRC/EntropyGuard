@router.post("/api/anomaly-action")
async def anomaly_action(request: Request):
    """记录用户对异常检测的响应（确认继续 或 暂停会话）。"""
    try:
        data = await request.json()
        action = data.get("action", "dismiss")  # "dismiss" 或 "halt"
        rule = data.get("rule", "unknown")

        state.append_event({
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "actor": "human",
            "event_type": f"ANOMALY_{action.upper()}",
            "action": rule,
            "delta_entropy": 0,
            "entropy_delta": 0,
            "success": True,
        })

        if action == "halt":
            state.event_log = []
            state.current_gear = 1
            state.control_entropy = 0.0
            state._save_events()

        return JSONResponse({"success": True, "action": action})
    except Exception as e:
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


