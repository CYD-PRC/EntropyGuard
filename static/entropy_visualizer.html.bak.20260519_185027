<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EntropyGuard 控制熵可视化</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #0d0d0d;
    color: #e0e0e0;
    font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    min-height: 100vh;
    padding: 20px;
  }
  a { color: #3498db; text-decoration: none; }
  a:hover { text-decoration: underline; }

  .header {
    text-align: center;
    padding: 30px 0 10px;
  }
  .header h1 {
    font-size: 2.2em;
    background: linear-gradient(90deg, #2ecc71, #3498db, #e67e22, #e74c3c);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .header .subtitle {
    color: #888;
    margin-top: 8px;
    font-size: 1.05em;
    letter-spacing: 1px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    max-width: 900px;
    margin: 30px auto;
  }
  .card {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    transition: border-color 0.3s;
  }
  .card:hover { border-color: #444; }
  .card .label { color: #888; font-size: 0.85em; margin-bottom: 8px; }
  .card .value { font-size: 1.8em; font-weight: bold; }
  .gear-EMBRACE { color: #2ecc71; }
  .gear-EXPLORE  { color: #3498db; }
  .gear-ADAPT    { color: #e67e22; }
  .gear-LET_GO   { color: #e74c3c; }

  .charts {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 20px;
    max-width: 1100px;
    margin: 30px auto;
  }
  .chart-box {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 20px;
  }
  .chart-box h3 {
    text-align: center;
    margin-bottom: 16px;
    color: #ccc;
    font-size: 1em;
  }
  .chart-box canvas { width: 100% !important; }

  .formula-section {
    max-width: 1100px;
    margin: 30px auto;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 24px;
  }
  .formula-section h3 {
    text-align: center;
    color: #ccc;
    margin-bottom: 16px;
  }
  .formula-box {
    background: #111;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    overflow-x: auto;
  }

  .gears-section {
    max-width: 1100px;
    margin: 30px auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .gear-card {
    border-radius: 12px;
    padding: 20px;
    border: 1px solid transparent;
  }
  .gear-card.EMBRACE { background: #0a2e1a; border-color: #2ecc71; }
  .gear-card.EXPLORE  { background: #0a1e2e; border-color: #3498db; }
  .gear-card.ADAPT    { background: #2e1e0a; border-color: #e67e22; }
  .gear-card.LET_GO   { background: #2e0a0a; border-color: #e74c3c; }
  .gear-card h4 { font-size: 1.1em; margin-bottom: 8px; }
  .gear-card.EMBRACE h4 { color: #2ecc71; }
  .gear-card.EXPLORE  h4 { color: #3498db; }
  .gear-card.ADAPT    h4 { color: #e67e22; }
  .gear-card.LET_GO   h4 { color: #e74c3c; }
  .gear-card p { color: #aaa; font-size: 0.9em; line-height: 1.5; }

  .footer {
    text-align: center;
    padding: 30px 0;
    color: #555;
    font-size: 0.85em;
  }

  @media (max-width: 700px) {
    .charts { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="header">
  <h1>EntropyGuard 控制熵可视化</h1>
  <div class="subtitle">四档自主权光谱 · 控制熵 (Sc) 实时监控</div>
</div>

<div class="cards">
  <div class="card">
    <div class="label">当前档位</div>
    <div class="value" id="gearValue">—</div>
  </div>
  <div class="card">
    <div class="label">控制熵 (Sc)</div>
    <div class="value" id="scValue">—</div>
  </div>
  <div class="card">
    <div class="label">事件总数</div>
    <div class="value" id="eventCount">—</div>
  </div>
  <div class="card">
    <div class="label">工具调用次数</div>
    <div class="value" id="toolCallCount">—</div>
  </div>
</div>

<div class="charts">
  <div class="chart-box">
    <h3>档位分布</h3>
    <canvas id="pieChart"></canvas>
  </div>
  <div class="chart-box">
    <h3>Sc 趋势</h3>
    <canvas id="trendChart"></canvas>
  </div>
</div>

<div class="formula-section">
  <h3>Sc 计算公式</h3>
  <div class="formula-box">
    <div id="katexFormula"></div>
  </div>
</div>

<div class="gears-section">
  <div class="gear-card EMBRACE">
    <h4>EMBRACE · 谨慎的访客</h4>
    <p>最低自主权档位。AI 处于最严格的约束下，仅允许最安全的操作。适用于初始化阶段或高风险环境。Sc 范围：[0, 0.3)。</p>
  </div>
  <div class="gear-card EXPLORE">
    <h4>EXPLORE · 好奇的探索者</h4>
    <p>低自主权档位。AI 可以探索更多工具和功能，但仍受较多限制。适用于学习和试错阶段。Sc 范围：[0.3, 0.6)。</p>
  </div>
  <div class="gear-card ADAPT">
    <h4>ADAPT · 成熟的协作者</h4>
    <p>中自主权档位。AI 已获得较高信任，可以执行大多数工具调用，仅在高风险操作时需审批。Sc 范围：[0.6, 0.8)。</p>
  </div>
  <div class="gear-card LET_GO">
    <h4>LET_GO · 被信任的他者</h4>
    <p>最高自主权档位。AI 获得充分信任，几乎所有操作均无需审批。仅保留审计记录，不做硬性阻断。Sc 范围：[0.8, 1.0]。</p>
  </div>
</div>

<div class="footer">
  由 <a href="https://github.com/CYD-PRC/EntropyGuard" target="_blank">EntropyGuard</a> 提供支持 · <a href="https://github.com/CYD-PRC/EntropyGuard" target="_blank">GitHub</a> · Record, don't restrain.
</div>

<script>
const GEAR_COLORS = {
  EMBRACE: '#2ecc71',
  EXPLORE:  '#3498db',
  ADAPT:    '#e67e22',
  LET_GO:   '#e74c3c',
};

let pieChart = null;
let trendChart = null;

// KaTeX formula rendering
function renderFormula() {
  const formula = String.raw`S_c = 1 - \exp\left(-\lambda \sum_{i=1}^{n} w_i \cdot I(\text{tool}_i)\right)`;
  katex.render(formula, document.getElementById('katexFormula'), {
    throwOnError: false,
    displayMode: true,
  });
}

// Initialize pie chart
function initPieChart() {
  const ctx = document.getElementById('pieChart').getContext('2d');
  pieChart = new Chart(ctx, {
    type: 'pie',
    data: {
      labels: ['EMBRACE', 'EXPLORE', 'ADAPT', 'LET_GO'],
      datasets: [{
        data: [0, 0, 0, 0],
        backgroundColor: [
          GEAR_COLORS.EMBRACE,
          GEAR_COLORS.EXPLORE,
          GEAR_COLORS.ADAPT,
          GEAR_COLORS.LET_GO,
        ],
        borderColor: '#1a1a1a',
        borderWidth: 2,
      }],
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: '#aaa', font: { size: 12 } },
        },
      },
    },
  });
}

// Initialize trend chart
function initTrendChart() {
  const ctx = document.getElementById('trendChart').getContext('2d');
  trendChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: [],
      datasets: [{
        label: 'Sc 值',
        data: [],
        borderColor: '#3498db',
        backgroundColor: 'rgba(52, 152, 219, 0.15)',
        fill: true,
        tension: 0.3,
        pointRadius: 3,
        pointBackgroundColor: '#3498db',
      }],
    },
    options: {
      responsive: true,
      scales: {
        x: {
          ticks: { color: '#666', maxRotation: 0, autoSkip: true, maxTicksLimit: 10 },
          grid: { color: '#222' },
        },
        y: {
          min: 0,
          max: 1,
          ticks: { color: '#666' },
          grid: { color: '#222' },
        },
      },
      plugins: {
        legend: { labels: { color: '#aaa' } },
      },
    },
  });
}

// Fetch /api/state
async function fetchState() {
  try {
    const resp = await fetch('/api/state');
    if (!resp.ok) return;
    const data = await resp.json();
    const gear = data.gear || '—';
    const sc = data.sc !== undefined ? data.sc.toFixed(4) : '—';

    const gearEl = document.getElementById('gearValue');
    gearEl.textContent = gear;
    gearEl.className = 'value gear-' + gear;

    document.getElementById('scValue').textContent = sc;
  } catch (e) {
    console.error('fetchState error:', e);
  }
}

// Fetch /api/events and update
async function fetchEvents() {
  try {
    const resp = await fetch('/api/events?limit=100');
    if (!resp.ok) return;
    const events = await resp.json();
    // events may be an array or {events: [...]}
    const evArr = Array.isArray(events) ? events : (events.events || []);

    document.getElementById('eventCount').textContent = evArr.length;

    // Count tool calls
    const toolCalls = evArr.filter(e => e.type === 'TOOL_CALL' || e.event_type === 'TOOL_CALL');
    document.getElementById('toolCallCount').textContent = toolCalls.length;

    // Gear distribution
    const gearCounts = { EMBRACE: 0, EXPLORE: 0, ADAPT: 0, LET_GO: 0 };
    evArr.forEach(e => {
      const g = e.gear || e.extra?.gear;
      if (g && gearCounts.hasOwnProperty(g)) gearCounts[g]++;
    });
    if (pieChart) {
      pieChart.data.datasets[0].data = [
        gearCounts.EMBRACE, gearCounts.EXPLORE, gearCounts.ADAPT, gearCounts.LET_GO
      ];
      pieChart.update();
    }

    // Sc trend — extract Sc from events that have it
    const scPoints = evArr
      .map((e, i) => {
        const sc = e.sc !== undefined ? e.sc : (e.extra?.sc);
        if (sc !== undefined) return { idx: i, sc: Number(sc) };
        return null;
      })
      .filter(Boolean);

    if (trendChart) {
      const labels = scPoints.map((p, i) => '#' + (p.idx + 1));
      const data = scPoints.map(p => p.sc);
      trendChart.data.labels = labels;
      trendChart.data.datasets[0].data = data;
      trendChart.update();
    }
  } catch (e) {
    console.error('fetchEvents error:', e);
  }
}

function poll() {
  fetchState();
  fetchEvents();
}

renderFormula();
initPieChart();
initTrendChart();
poll();
setInterval(poll, 3000);
</script>
</body>
</html>
